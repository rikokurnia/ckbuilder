# ===================================================
# AgentBounty Environment Variables (Example)
# ===================================================

# Google Gemini API Key for AI Worker Execution (Model: gemini-3.5-flash)
# Copy this file to .env and insert your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini Model - strictly Gemini 3.5+ (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Testnet-only runtime guard and RPC endpoint
CKB_NETWORK=testnet
CKB_RPC_URL=https://testnet.ckb.dev/rpc

# Server-only application secrets (generate each independently with openssl rand -hex 32)
APP_AUTH_SECRET=
APP_ENCRYPTION_KEY=
APP_RECEIPT_SIGNING_KEY=

# Hosted persistence. Never expose the service-role key with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Submission/demo payment mode
PAYMENT_ADAPTER=mock
ALLOW_MODEL_FALLBACK=false
ALLOW_DEMO_ACCEPTANCE=false
ALLOW_GUEST_MUTATIONS=false
