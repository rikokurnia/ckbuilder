# ===================================================
# AgentBounty Environment Variables (Example)
# ===================================================

# Google Gemini API Key for AI Worker Execution (Model: gemini-3.5-flash)
# Copy this file to .env and insert your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini Model - strictly Gemini 3.5+ (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# (Optional) CKB RPC Endpoint (Testnet)
CKB_RPC_URL=https://testnet.ckb.dev/rpc

