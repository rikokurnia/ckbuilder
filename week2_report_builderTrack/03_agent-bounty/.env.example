# ===================================================
# AgentBounty Environment Variables
# ===================================================

# Google Gemini API Key for AI Worker Execution (Model: gemini-1.5-flash)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Preferred Gemini Model - default is gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# (Optional) CKB RPC Endpoint (Testnet)
CKB_RPC_URL=https://testnet.ckb.dev/rpc
