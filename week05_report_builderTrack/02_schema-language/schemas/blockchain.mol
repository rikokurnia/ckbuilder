// Official Nervos CKB Blockchain Types Defined in Molecule
// Reference: nervosnetwork/ckb/util/types/schemas/blockchain.mol

array Byte32 [byte; 32];
array Uint32 [byte; 4];
array Uint64 [byte; 8];

vector Bytes <byte>;
vector CellInputVec <CellInput>;
vector CellOutputVec <CellOutput>;
vector BytesVec <Bytes>;

struct OutPoint {
    tx_hash: Byte32,
    index:   Uint32,
}

struct CellInput {
    since:           Uint64,
    previous_output: OutPoint,
}

table Script {
    code_hash: Byte32,
    hash_type: byte,
    args:      Bytes,
}

option ScriptOpt (Script);

table CellOutput {
    capacity: Uint64,
    lock:     Script,
    type_:    ScriptOpt,
}

table RawTransaction {
    version:      Uint32,
    cell_deps:    BytesVec,
    header_deps:  BytesVec,
    inputs:       CellInputVec,
    outputs:      CellOutputVec,
    outputs_data: BytesVec,
}

table Transaction {
    raw:       RawTransaction,
    witnesses: BytesVec,
}
