# Required outside local demo mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_AUTH_SECRET=
APP_ENCRYPTION_KEY=
APP_RECEIPT_SIGNING_KEY=
CKB_NETWORK=testnet

# Vercel/hosted persistence. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local persistence fallback. Vercel uses Supabase when the variables above are set.
AGENT_BOUNTY_DATA_FILE=.data/agentbounty.json

# Local demonstrator defaults
PAYMENT_ADAPTER=mock
ALLOW_MODEL_FALLBACK=false
ALLOW_DEMO_ACCEPTANCE=false
ALLOW_GUEST_MUTATIONS=false

# Native Fiber mode. Complete docs/fnn-spike.sh before enabling.
FNN_RECEIVER_RPC_URL=http://127.0.0.1:8227
FNN_PAYER_RPC_URL=http://127.0.0.1:8229

# Existing CCC client setting
CKB_RPC_URL=https://testnet.ckb.dev/rpc
